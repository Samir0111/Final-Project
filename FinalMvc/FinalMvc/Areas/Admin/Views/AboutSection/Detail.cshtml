@model AboutSectionVM

<div class="container mt-5">
    <div class="card shadow-lg">
        <div class="card-header bg-dark text-white text-center">
            <h2>@Model.Title</h2>
            <h5 class="text-warning">@Model.Subtitle</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <!-- Main Image -->
                <div class="col-md-6 text-center">
                    <img src="~/assets/imgs/@Model.Image" alt="Main Image" class="img-fluid rounded mb-4" />
                </div>
                <!-- Profile Picture & Description -->
                <div class="col-md-6">
                    <h4 class="mb-3">Description</h4>
                    <p>@Model.Desc</p>
                    <hr />
                    <div class="d-flex align-items-center mt-3">
                        <img src="~/assets/imgs/@Model.Pfp" alt="Profile Picture" class="rounded-circle" width="70" height="70" />
                        <div class="ms-3">
                            <h5 class="mb-1">@Model.Name</h5>
                            <span class="text-muted">@Model.Position</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer text-center">
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>
