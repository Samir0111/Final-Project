@model ChefsteamVM

<div class="container mt-5">
    <h2 class="text-center">Chef Details</h2>
    <div class="card mt-4">
        <div class="card-body text-center">
            <h4>Name: @Model.Name</h4>
            <h5>Position: @Model.Position</h5>
            <img src="~/assets/imgs/@Model.Image" alt="@Model.Name" width="150" class="mt-3" />
        </div>
    </div>
    <div class="mt-3 text-center">
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
