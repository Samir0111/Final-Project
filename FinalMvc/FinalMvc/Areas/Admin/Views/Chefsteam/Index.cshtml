@model IEnumerable<ChefsteamVM>

<div class="container mt-5">
    <h1 class="text-center">Chefs Team</h1>
    <div class="create-area mb-3">
        <a asp-action="Create" class="btn btn-success">Add New Chef</a>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Position</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    
                
               
                @foreach (var chef in Model)
                {
                    <tr>
                        <td>
                            <img src="~/assets/imgs/@chef.Image" alt="@chef.Name" width="100" />
                        </td>
                        <td>@chef.Name</td>
                        <td>@chef.Position</td>
                        <td class="d-flex justify-content-around">
                            <a asp-action="Detail" asp-route-id="@chef.Id" class="btn btn-outline-primary">Detail</a>
                            <a asp-action="Edit" asp-route-id="@chef.Id" class="btn btn-outline-secondary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@chef.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }

                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">Nothing found</td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>
