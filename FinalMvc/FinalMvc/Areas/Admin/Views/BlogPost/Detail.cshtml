@model BlogPostVM

<div class="container mt-5">
    <h2 class="text-center">Blog Post Details</h2>
    <div class="card mt-4">
        <div class="card-body">
            <div class="text-center">
                <img src="~/assets/imgs/@Model.Image" alt="Blog Image" class="img-fluid mb-3" style="max-width: 200px;" />
            </div>
            <h5>Category: @Model.Category</h5>
            <h6>Date: @Model.Date</h6>
            <h6>Author: @Model.ByWho</h6>
            <h5>Title:</h5>
            <p>@Model.Title</p>
            <h5>Description:</h5>
            <p>@Model.Description</p>
        </div>
    </div>
    <div class="mt-3 text-center">
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
