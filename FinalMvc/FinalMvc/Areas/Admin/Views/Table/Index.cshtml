@model IEnumerable<TableVM>

<div class="container mt-5">
    <h1 class="text-center">Tables</h1>
    <div class="create-area mb-3">
        <a asp-action="Create" class="btn btn-success">Add New Table</a>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Table Number</th>
                    <th>Guest Capacity</th>
                    <th>Availability Start</th>
                    <th>Availability End</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.TableNumber</td>
                            <td>@item.GuestCapacity</td>
                            <td>@(item.AvailabilityStart.HasValue ? item.AvailabilityStart.Value.ToString("yyyy-MM-dd HH:mm") : "N/A")</td>
                            <td>@(item.AvailabilityEnd.HasValue ? item.AvailabilityEnd.Value.ToString("yyyy-MM-dd HH:mm") : "N/A")</td>
                            <td class="d-flex justify-content-around">
                                <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-outline-primary">Detail</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No tables found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
