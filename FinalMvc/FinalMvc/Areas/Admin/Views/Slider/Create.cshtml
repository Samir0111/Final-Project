@model SliderVM



<div class="container mt-5">
    <h2 class="text-center">Create Slider</h2>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="form-group">
            <label asp-for="Title">Title</label>
            <input asp-for="Title" type="text" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="SubTitle">SubTitle</label>
            <input asp-for="SubTitle" type="text" class="form-control" />
            <span asp-validation-for="SubTitle" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Desc">Description</label>
            <textarea asp-for="Desc" class="form-control"></textarea>
            <span asp-validation-for="Desc" class="text-danger"></span>
        </div>

      

        <div class="form-group">
            <label asp-for="Photo">Upload Image</label>
            <input asp-for="Photo" type="file" class="form-control" />
            <span asp-validation-for="Photo" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success mt-3">Create Slider</button>
        <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
    </form>
</div>
