@model IEnumerable<FinalMvc.Models.Contact>

<div class="container mt-5">
    <h1 class="text-center mb-4">Manage Contacts</h1>


    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Message</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var contact in Model)
                {
                    <tr>
                        <td>@contact.FirstName @contact.LastName</td>
                        <td>@contact.Email</td>
                        <td>@contact.Message.Substring(0, Math.Min(contact.Message.Length, 50))...</td>
                        <td class="text-center">
                            <a asp-action="Detail" asp-route-id="@contact.Id" class="btn btn-info btn-sm">Detail</a>
                            <form asp-action="Delete" asp-route-id="@contact.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No contacts available.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
