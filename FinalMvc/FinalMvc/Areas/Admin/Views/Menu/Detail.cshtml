@model FinalMvc.Models.Food

<div class="container mt-5">
    <h2 class="text-center">@Model.Name</h2>
    <div class="row">
        <div class="col-md-6">
            <img src="~/images/@Model.Image" alt="@Model.Name" class="img-fluid">
        </div>
        <div class="col-md-6">
            <h4>Category: @Model.FoodCategory.Name</h4>
            <p>@Model.Description</p>
            <p>Price: $@Model.Price.ToString("F2")</p>
            <p>Sell Price: @(Model.SellPrice.HasValue ? "$" + Model.SellPrice.Value.ToString("F2") : "N/A")</p>
        </div>
    </div>
</div>
