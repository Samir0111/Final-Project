@model FinalMvc.ViewModels.Admin.Menu.MenuVM

<div class="container">
    <h1>Edit Food</h1>
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Price"></label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="SellPrice"></label>
            <input asp-for="SellPrice" class="form-control" />
            <span asp-validation-for="SellPrice" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Photo">Upload New Image</label>
            <input asp-for="Photo" type="file" class="form-control-file" />
            <span asp-validation-for="Photo" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="FoodCategoryId">Category</label>
            <select asp-for="FoodCategoryId" class="form-control" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))"></select>
            <span asp-validation-for="FoodCategoryId" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </form>
</div>
