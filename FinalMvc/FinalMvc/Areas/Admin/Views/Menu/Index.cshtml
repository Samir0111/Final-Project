@model IEnumerable<FinalMvc.Models.Food>

<div class="container">
    <h1>Food Menu</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">Create New Food</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Sell Price</th>
                <th>Category</th>
                <th>Image</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var food in Model)
                {
                    <tr>
                        <td>@food.Name</td>
                        <td>@food.Description</td>
                        <td>@food.Price</td>
                        <td>@(food.SellPrice.HasValue ? food.SellPrice.Value.ToString("") : "-")</td>
                        <td>@food.FoodCategory.Name</td>
                        <td>
                            <img src="/assets/imgs/@food.Image" alt="@food.Name" style="max-width: 100px; height: auto;" />
                        </td>
                        <td class="text-center">
                            <a asp-action="Detail" asp-route-id="@food.Id" class="btn btn-info btn-sm">Detail</a>
                            <a asp-action="Edit" asp-route-id="@food.Id" class="btn btn-warning btn-sm">Edit</a>
                            <form asp-action="Delete" asp-route-id="@food.Id" method="post" style="display: inline-block;">
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this item?');">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">No food items available.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
