@model IEnumerable<Showcasemenu>


<div class="container mt-5">
    <h1 class="text-center">Showcase Menu</h1>
    <div class="create-area mb-3">
        <a asp-action="Create" class="btn btn-success">Create New Menu Item</a>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {



                    @foreach (var menu in Model)
                    {
                        <tr>
                            <td>
                                <img src="~/assets/imgs/@menu.Foodpic" alt="Menu Image" style="width: 80px; height:auto;" />
                            </td>
                            <td class="d-flex justify-content-around">
                                <a asp-action="Detail" asp-route-id="@menu.Id" class="btn btn-outline-primary">Detail</a>
                                <a asp-action="Edit" asp-route-id="@menu.Id" class="btn btn-outline-secondary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@menu.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }

                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">Nothing found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
