@model VideoPreviewVM

<div class="container mt-5">
    <h2 class="text-center">Add New Video</h2>
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="form-group">
            <label asp-for="YtLink">YouTube Link</label>
            <input asp-for="YtLink" type="text" class="form-control" />
            <span asp-validation-for="YtLink" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Photo">Upload Preview Image</label>
            <input asp-for="Photo" type="file" class="form-control" />
            <span asp-validation-for="Photo" class="text-danger"></span>
        </div>

      

        <button type="submit" class="btn btn-primary mt-3">Add Video</button>
        <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
    </form>
</div>
