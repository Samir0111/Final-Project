@model IEnumerable<AppointmentSectionVM>

<div class="container mt-5">
    <h1 class="text-center">Appointment Sections</h1>
    <div class="create-area mb-3">
        <a asp-action="Create" class="btn btn-success">Add New Section</a>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Catch</th>
                    <th>Title</th>
                    <th>Subtitle</th>
                    <th>Is Main </th>

                    <th>Actions</th>

                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Catch</td>
                            <td>@item.Title</td>
                            <td>@item.Subtitle</td>
                            <td>@(item.IsMain ? "Yes" : "No")</td>

                            <td class="d-flex justify-content-around">
                                <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-outline-primary">Detail</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                                <form asp-action="ChangeMainStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn @(item.IsMain ? "btn-success btn-disabled-custom" : "btn-danger")">
                                        Change Main Status
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">No sections found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
