<section id="testimonial-section" class="py-5">
    <div class="container" id="testimonial-container">
        <h2 class="text-center mb-4" style="font-family: 'Poppinsfour', sans-serif; color: #fff;">Add a Testimonial</h2>
        <form asp-action="Submit" asp-controller="Testimonial" method="post">
            <div class="testimonial-box" style="background-color: #252526; padding: 20px; border-radius: 10px;">
                <div class="star-rating text-center mb-3">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="star" data-value="@i" onclick="setRating(@i)">&#9734;</span>
                        }
                </div>
                <input type="hidden" id="testimonial-rating" name="Rating" value="0" />
                <span class="text-danger" asp-validation-for="Rating"></span>

                <textarea id="testimonial-comment" name="Comment" class="form-control mb-3" rows="4"
                    placeholder="Write your comment here..." style="background-color: #333; color: #fff; border: none; border-radius: 5px; padding: 10px;"></textarea>
                <span class="text-danger" asp-validation-for="Comment"></span>

                <input id="testimonial-username" name="Username" type="text" class="form-control mb-3" placeholder="Your Name"
                    style="background-color: #333; color: #fff; border: none; border-radius: 5px; padding: 10px;">
                <span class="text-danger" asp-validation-for="Username"></span>

                <button id="submit-testimonial" class="btn btn-warning w-100" type="submit"
                    style="background-color: #ffc107; color: #111; font-weight: bold;">Submit</button>
            </div>
        </form>
    </div>
</section>

    @section Scripts {
        <script>
            function setRating(value) {
                document.getElementById('testimonial-rating').value = value;
                const stars = document.querySelectorAll('.star');
                stars.forEach((star, index) => {
                    if (index < value) {
                        star.style.color = 'gold';
                    } else {
                        star.style.color = '';
                    }
                });
            }
        </script>
    }

 *@



