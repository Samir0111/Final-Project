@model BlogVM
<main>

  <section class="headerbottomabout-section" style="background-image: url('../assets/imgs/test-bg.png');">
    <div class="container text-center">
        <div class="headerbottomabout-content">
            <h1 class="headerbottomabout-title">BLOG</h1>
            <nav class="breadcrumb">
                <a href="index.html">Home</a>
                <span>></span>
                <a href="#" class="active">Blog</a>
            </nav>
        </div>
    </div>
</section>


  <section id="blog-main-section" class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div id="newsSlider" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-indicators">
                    </div>

                        <div class="carousel-inner">
                            @{
                                var isFirst = true; 
                            }
                            @foreach (var item in Model.BlogPosts)
                            {
                                <div class="carousel-item @(isFirst ? "active" : "")">
                                    <div class="news-card">
                                        <div class="news-image">
                                            <img src="~/assets/imgs/@item.Image" alt="News Image" class="d-block w-100">
                                            <span class="news-category">@item.Category</span>
                                        </div>
                                        <div class="p-3">
                                            <p class="news-meta">
                                                <span><i class="fas fa-calendar-alt"></i> @item.Date</span> &nbsp;|&nbsp;
                                                <span><i class="fas fa-user"></i> @item.ByWho</span>
                                            </p>
                                            <h3 class="news-title">@item.Title</h3>
                                            <p class="news-description">@item.Description</p>
                                        </div>
                                    </div>
                                </div>
                                isFirst = false; 
                            }
                        </div>


                    <button class="carousel-control-prev" type="button" data-bs-target="#newsSlider" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#newsSlider" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>


            <div class="col-lg-4">
                <section id="search-section">
                    <div class="search-container">
                        <h4 class="search-title">Search</h4>
                        <div class="search-box">
                            <input type="text" class="search-input" placeholder="Search your keyword...">
                            <button class="search-button">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </section>

                <section id="follow-us-section" class="mt-4">
                    <div class="follow-us-container">
                        <h4 class="follow-us-title">Follow Us</h4>
                        <div class="social-icons">
                            <i class="fab fa-twitter"></i>
                            <i class="fab fa-pinterest"></i>
                            <i class="fab fa-facebook"></i>
                            <i class="fab fa-instagram"></i>
                            <i class="fab fa-wordpress"></i>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</section>


