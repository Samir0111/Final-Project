@* @model TestimonialVM *@

@model TestimonialPageVM

@{
    ViewBag.Title = "Add Testimonial";
}




<section class="headerbottomabout-section" style="background-image: url('../assets/imgs/test-bg.png');">
    <div class="container text-center">
        <div class="headerbottomabout-content">
            <h1 class="headerbottomabout-title">TESTIMONIAL</h1>
            <nav class="breadcrumb">
                <a href="index.html">Home</a>
                <span>></span>
                <a href="#" class="active">Testimonial</a>
            </nav>
        </div>
    </div>
</section>


<div class="container mt-5 pt-5" >
    <h2 class="mb-4 text-center text-white" style="font-family: Poppins;">Add a Testimonial</h2>

  

    <form asp-action="AddTestimonial" asp-controller="TestimonialPage" method="post">
        <!-- Comment Field -->
        <div class="form-group mb-3">
            <label asp-for="Comment" class="form-label text-white">Comment</label>
            <textarea asp-for="Comment" class="form-control" style="background-color: #333; color: #fff; border: none; border-radius: 5px; margin-bottom:2%;"></textarea>
            <span asp-validation-for="Comment" class="text-danger"></span>
        </div>

        <!-- User Name Field -->
        <div class="form-group mb-3">
            <label asp-for="UserName" class="form-label text-white">User Name</label>
            <input asp-for="UserName" class="form-control" style="background-color: #333; color: #fff; border: none; border-radius: 5px; margin-bottom:2%;" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>

        <!-- 5-Star Rating System -->
        <div class="form-group mb-3">
            <label class="form-label text-white">Rating</label>
            <div class="rating">
                @for (int i = 5; i >= 1; i--)
                {
                    <input type="radio" id="star-@i" name="Rating" value="@i" />
                    <label for="star-@i" title="@i stars">
                        ★
                    </label>
                }
            </div>
            <span asp-validation-for="Rating" class="text-danger"></span>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-warning w-100" style="background-color: #ffc107; color: #111; font-weight: bold; margin-bottom:5%;">Submit</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            @Model.SuccessMessage
        </div>
    }
</div>

@section Styles {
    <style>
        .rating {
            direction: rtl; 
            font-size: 2em;
            display: flex;
            gap: 0.3em;
        }

        .rating input[type="radio"] {
            display: none;
        }

        .rating label {
            color: #ccc;
            cursor: pointer;
            user-select: none;
        }

        .rating input[type="radio"]:checked ~ label,
        .rating input[type="radio"]:checked ~ label ~ label {
            color: #FFD700; 
        }

        .rating label:hover,
        .rating label:hover ~ label {
            color: #FFD700; 
        }

        textarea {
            resize: none;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.3/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
}

