@model ForgotPasswordVM

<div class="container mt-5 d-flex justify-content-center align-items-center" style="min-height: 100vh; padding-top: 80px;">
    <div class="card p-5 shadow-lg" style="max-width: 400px; width: 100%; border: none;">
        <h1 class="text-center mb-4" style="color: #ff8500; font-weight: bold;">Forgot Password</h1>

        <p class="text-center mb-4" style="color: gray; font-size: 16px;">
            Enter your email address below, and we'll send you a link to reset your password.
        </p>


        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <div class="form-group mb-4">
                <label for="email" class="form-label" style="color: gray; font-weight: bold;">Email Address</label>
                <input asp-for="Email" id="email" type="email" class="form-control" style="border-color: #ff8500;" placeholder="Enter your email" required />
                <span asp-validation-for="Email" class="text-danger" style="margin-top: 4px; display: block;"></span>
            </div>

            <div class="d-flex justify-content-center">
                <button type="submit" class="btn btn-warning w-100" style="background-color: #ff8500; border: none; font-weight: bold;">Send Reset Link</button>
            </div>
        </form>
    </div>
</div>

<!-- Optional CSS -->
<style>
    body {
        background-color: #121212; /* Matches the login page */
    }

    .card {
        border-radius: 10px;
    }

    .btn-warning:hover {
        background-color: #ff9900;
    }
</style>
