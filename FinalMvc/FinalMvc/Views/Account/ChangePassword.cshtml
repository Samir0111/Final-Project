
@model ChangePasswordVM








<main>

    <section class="headerbottomabout-section" style="background-image: url('../assets/imgs/test-bg.png');">
        <div class="container text-center">
            <div class="headerbottomabout-content">
                <h1 class="headerbottomabout-title">Account</h1>
                <nav class="breadcrumb">
                    <a href="index.html">Home</a>
                    <span>></span>
                    <a href="#" class="active">Account</a>
                </nav>
            </div>
        </div>
    </section>

    <section class="current-account-info">
        <div class="container">
            <h2 class="section-title">Your Account Information</h2>
            <div class="info-box">
                <div class="info-item">
                    <h4>Email:</h4>
                    <p>@TempData["Email"]</p>
                </div>
                <div class="info-item">
                    <h4>Username:</h4>
                    <p>@TempData["Username"]</p>
                </div>
            </div>
        </div>
    </section>


<section class="change-password-section">
    <div class="container">
        <h2 class="section-title">Change Password</h2>
        <p class="section-subtitle">Ensure your account is protected by changing your password regularly.</p>

       

        <form asp-action="ChangePassword" asp-controller="Account" method="post" class="password-form">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="current-password">Current Password</label>
                <div class="password-wrapper">
                    <input asp-for="CurrentPassword" class="form-control" id="current-password" placeholder="Enter your current password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    <i class="toggle-password fas fa-eye" data-target="#current-password"></i>
                </div>
            </div>

            <div class="form-group">
                <label for="new-password">New Password</label>
                <div class="password-wrapper">
                    <input asp-for="NewPassword" class="form-control" id="new-password" placeholder="Enter your new password" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                    <i class="toggle-password fas fa-eye" data-target="#new-password"></i>
                </div>
            </div>

            <div class="form-group">
                <label for="confirm-password">Confirm New Password</label>
                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword" class="form-control" id="confirm-password" placeholder="Confirm your new password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    <i class="toggle-password fas fa-eye" data-target="#confirm-password"></i>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-submit">Change Password</button>
        </form>
    </div>
</section>


   

   









</main> 



 <style>
        @@media (min-width: 768px) {
            .password-form {
               position:relative;
               left: 25%;
            }
        }

    @@media (min-width: 1200px) {
        .change-password-section .section-title {
          margin-left:-9%;
        }
    }
    </style>

