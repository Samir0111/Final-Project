    <section class="call-to-action-section">
        <div class="container d-flex align-items-center justify-content-between">
            @foreach (var item in Model.AppointmentSections)
            {
                @if (item.IsMain)
                {
                    <div class="cta-text-content">
                        <h3 class="cta-title">@item.Catch</h3>
                <h2 class="cta-heading">@item.Title</h2>
                <p class="cta-subtitle">@item.Subtitle</p>
            </div>
                }
            }
            <div class="cta-form-content d-flex align-items-center ">
                <div class="cta-form-item position-relative">
                    <img src="~/assets/imgs/booknow-icon1.png" alt="Check-In Icon" class="cta-icon">
                    <div>
                        <p class="cta-form-label">CHECK IN</p>
                    </div>
                </div>
                <div class="cta-divider"></div>
                <div class="cta-form-item position-relative">
                    <img src="~/assets/imgs/booknow-icon4.png" alt="Time Icon" class="cta-icon">
                    <div>
                        <p class="cta-form-label">TIME</p>

                    </div>
                </div>
                <div class="cta-divider"></div>
                <div class="cta-form-item position-relative">
                    <img src="~/assets/imgs/booknow-icon2.png" alt="Guests Icon" class="cta-icon">
                    <div>
                        <p class="cta-form-label">GUESTS</p>
                        <div class="dropdown">
                        </div>
                    </div>
                </div>
                <div class="cta-button-container">
                    <a href="./reservation.html" class="btn-yellow" id="bookNowBtn">BOOK NOW</a>
                </div>
            </div>
        </div>
    </section>

