    <section class="menu-section py-5">
        <div class="container text-center">
            <div class="section-title">
                <div class="meow-menu">
                    <h3>SHOWCASE</h3>
                    <h2>FOOD MENUS</h2>
                    <div class="divider"></div>
                </div>
            </div>
            <div class="row g-4">
                @foreach (var food in Model.Showcasemenus)
                {
                    <div class="col-md-3 col-sm-6">
                        <div class="menu-item">
                            <img src="~/assets/imgs/@food.Foodpic" alt="Menu Item 1" class="img-fluid food-image" onclick="openImageFullscreen(this)">
                        </div>
                    </div>

                }
             
            </div>
        </div>

        <div id="fullscreenModal" class="fullscreen-modal" onclick="closeImageFullscreen()">
            <img id="fullscreenImage" src="" alt="Expanded Image">
            <span class="close-btn">&times;</span>
        </div>
    </section>


    <section class="our-chefs-section" style="background-image: url('../assets/imgs/team-bg.png' );  background-size: cover;">
        <div class="container py-5 text-center">
            <div class="section-title mb-5 meow-chefs">
                <h3 class="text-uppercase text-warning">Team</h3>
                <h2 class="display-4 font-weight-bold">Our Chefs</h2>
                <div class="divider mx-auto my-3" style="width: 60px; height: 3px; background-color: #ffc107;"></div>
            </div>

            <div class="row justify-content-center">

                @foreach (var item in Model.Chefsteams)
                {
                    <div class="col-md-4 mb-4">
                        <div class="chef-card position-relative overflow-hidden">
                            <img src="~/assets/imgs/@item.Image" alt="@item.Name" class="img-fluid rounded">
                            <div class="chef-overlay d-flex flex-column justify-content-center align-items-center">
                                <h4 class="chef-name text-white mb-2">@item.Name</h4>
                                <p class="chef-role text-warning">@item.Position</p>
                            </div>
                        </div>
                    </div>

                }

             
            </div>
        </div>
    </section>


    @foreach(var item in Model.VideoPreviews)
    {
        @if (item.IsMain)
        {
            <section id="media" class="media-section pt-200 pb-200" style="background-image:url('../assets/imgs/@item.PreviewImage'); background-size: cover; background-position: center center; background-repeat: no-repeat;">
                <div class="container">
                <div class="row">
                    <div class="col-xl-12 text-center">
                        <a href="@item.YtLink" class="video-link mt-100 mb-100">
                            <img src="~/assets/imgs/play.png" alt="Play Button" class="media-play-icon">
                        </a>
                    </div>
                </div>
            </div>
        </section>
        }
    }

    <section class="news-feeds-section py-5">
        <div class="container">
            <div class="section-title text-center mb-4 meow-news">
                <h3>BLOG</h3>
                <h2>NEWS FEEDS</h2>
                <div class="divider"></div>

            </div>
            <div class="row g-4">


                @foreach (var item in Model.BlogPosts)
                {



                    <div class="col-lg-4 col-md-6">
                        <div class="news-card">
                            <div class="news-image">
                                <img src="~/assets/imgs/@item.Image" alt="News Image 3">
                                <span class="news-category">@item.Category</span>
                            </div>
                            <div class="p-3">
                                <p class="news-meta">
                                    <span><i class="fas fa-calendar-alt"></i> @item.Date</span> &nbsp;|&nbsp;
                                    <span><i class="fas fa-user"></i> @item.ByWho</span>
                                </p>
                                <h3 class="news-title">@item.Title</h3>
                            </div>
                        </div>
                    </div>


                }


            </div>
        </div>
    </section>



