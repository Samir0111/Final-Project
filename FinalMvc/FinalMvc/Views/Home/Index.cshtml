
@model HomeVM

<main>
    <section class="slider-area">
        <div class="slider-background">
            <img src="~/assets/imgs/home-bg1.png" alt="Background" class="slider-bg-img">
        </div>
        <div class="slider-section">
            @foreach (var slider in Model.Sliders)
            {
                <div class="slide @(slider.IsMain ? "active" : "")">
                    <div class="slide-text">
                        <h2>@slider.Title <br><span>@slider.SubTitle</span></h2>
                        <p>@slider.Desc</p>
                        <a href="./about.html" class="btn-yellow">LEARN MORE</a>
                    </div>
                    <div class="slide-image">
                        <img src="~/assets/imgs/@slider.Image" alt="@slider.Title" class="circle-image">
                    </div>
                </div>
            }

            <div class="slider-nav-arrows">
                <button class="arrow-left">&#10094;</button>
                <button class="arrow-right">&#10095;</button>
            </div>
        </div>
    </section>


    
             @foreach(var item in Model.AboutSections)
    {
                @if (item.IsMain)
                {
    <section class="about-us-section">
        <div class="container d-flex align-items-center justify-content-between">
            <div class="about-us-image">
                <img src="~/assets/imgs/@item.Image" alt="About Us" class="img-fluid">
            </div>



                    <div class="about-us-content">
                        <h3>ABOUT US <span class="line"></span></h3>
                        <h2>@item.Title</h2>
                        <p class="subtitle">@item.Subtitle</p>
                        <p>@item.Desc</p>
                        <div class="founder-info d-flex align-items-center">
                            <div class="founder-photo">
                                <img src="~/assets/imgs/@item.Pfp" alt="Founder" class="img-fluid">
                            </div>
                            <div class="founder-details ms-3">
                                <h4>@item.Name</h4>
                                <span class="founder-title">@item.Position</span>
                            </div>
                        </div>
                    </div>
              

        
        
        </div>
    </section>
                }
    }
