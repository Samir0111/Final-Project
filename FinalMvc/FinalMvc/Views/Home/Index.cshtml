    <section class="testimonials-section" style="background-image: url('../assets/imgs/test-bg.png' );  background-size: cover;">
        <div class="container text-center py-5">
            <div class="section-title">
                <h3>TESTIMONIALS</h3>
                <h2>SOME FEEDBACKS</h2>
                <div class="divider"></div>
            </div>
            <div class="testimonials-carousel">
                @foreach (var testimonial in Model.Testimonials)
                {
                    <div class="testimonial-card">
                        <div class="stars">
                            @for (int i = 0; i < testimonial.Rating; i++)
                            {
                                <span>&#9733;</span>
                            }
                            @for (int i = testimonial.Rating; i < 5; i++)
                            {
                                <span style="color: #ccc;">&#9733;</span>
                            }
                        </div>
                        <p class="testimonial-text">@testimonial.Comment</p>
                        <h4 class="testimonial-author">@testimonial.UserName</h4>
                    </div>
                }
            </div>


