@model ContactPageVM
<main>

    <section class="headerbottomabout-section" style="background-image: url('../assets/imgs/test-bg.png');">
        <div class="container text-center">
            <div class="headerbottomabout-content">
                <h1 class="headerbottomabout-title">Contact</h1>
                <nav class="breadcrumb">
                    <a href="index.html">Home</a>
                    <span>></span>
                    <a href="#" class="active">Contact</a>
                </nav>
            </div>
        </div>
    </section>

    <section class="contact-section">
        <div class="container">
          
            <div class="row">
                <div class="col-md-6 contact-form">
                    <h2>Contact Us</h2>
                    <p>We'd love to hear from you! Fill out the form below, and we'll get back to you as soon as possible.</p>
              
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }
                    <form asp-action="SubmitContact" asp-controller="ContactPage" method="post">
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <input type="text" name="FirstName" placeholder="First Name" class="form-control" required>
                            <input type="text" name="LastName" placeholder="Last Name" class="form-control" required>
                        </div>
                        <input type="email" name="Email" placeholder="Your Email" class="form-control" required>
                        <textarea name="Message" rows="5" placeholder="Write your message here..." class="form-control" required></textarea>
                        <button type="submit" class="btn btn-yellow">Send Message</button>
                    </form>

                </div>

                <div class="col-md-6 contact-details">
                    <h2>Visit Us</h2>
                    <p>Come and see us at our restaurant or call us for inquiries.</p>
                    <ul>
                        <li><i class="fas fa-map-marker-alt"></i> 123 Foodie Street, Gourmet City</li>
                        <li><i class="fas fa-phone-alt"></i> +1 234 567 890</li>
                        <li><i class="fas fa-envelope"></i> contact@restaurant.com</li>
                    </ul>
                    <div class="map">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3153.835434509424!2d-122.40055668468162!3d37.79360097975637!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8085809c5b320a9d%3A0x5678664ae6f59c24!2s123%20Foodie%20St%2C%20San%20Francisco%2C%20CA%2094158%2C%20USA!5e0!3m2!1sen!2sin!4v1675063794231!5m2!1sen!2sin"
                                width="100%" height="250" frameborder="0" style="border:0;" allowfullscreen="" aria-hidden="false"
                                tabindex="0"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>