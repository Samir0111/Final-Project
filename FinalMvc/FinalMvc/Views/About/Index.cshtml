<main>

    <section class="headerbottomabout-section" style="background-image: url('./assets/imgs/test-bg.png');">
        <div class="container text-center">
            <div class="headerbottomabout-content">
                <h1 class="headerbottomabout-title">About Us</h1>
                <nav class="breadcrumb">
                    <a href="index.html">Home</a>
                    <span>></span>
                    <a href="#" class="active">About</a>
                </nav>
            </div>
        </div>
    </section>

    @foreach (var item in Model.AboutSections)
    {
        @if (item.IsMain)
        {
            <section class="about-us-section">
                <div class="container d-flex align-items-center justify-content-between">
                    <div class="about-us-image">
                        <img src="~/assets/imgs/@item.Image" alt="About Us" class="img-fluid">
                    </div>



                    <div class="about-us-content">
                        <h3>ABOUT US <span class="line"></span></h3>
                        <h2>@item.Title</h2>
                        <p class="subtitle">@item.Subtitle</p>
                        <p>@item.Desc</p>
                        <div class="founder-info d-flex align-items-center">
                            <div class="founder-photo">
                                <img src="~/assets/imgs/@item.Pfp" alt="Founder" class="img-fluid">
                            </div>
                            <div class="founder-details ms-3">
                                <h4>@item.Name</h4>
                                <span class="founder-title">@item.Position</span>
                            </div>
                        </div>
                    </div>




                </div>
            </section>
        }
    }
    <section class="our-chefs-section" style="background-image: url('../assets/imgs/team-bg.png' );  background-size: cover;">
        <div class="container py-5 text-center">
            <div class="section-title mb-5 meow-chefs">
                <h3 class="text-uppercase text-warning">Team</h3>
                <h2 class="display-4 font-weight-bold">Our Chefs</h2>
                <div class="divider mx-auto my-3" style="width: 60px; height: 3px; background-color: #ffc107;"></div>
            </div>

            <div class="row justify-content-center">

                @foreach (var item in Model.Chefsteams)
                {
                    <div class="col-md-4 mb-4">
                        <div class="chef-card position-relative overflow-hidden">
                            <img src="~/assets/imgs/@item.Image" alt="@item.Name" class="img-fluid rounded">
                            <div class="chef-overlay d-flex flex-column justify-content-center align-items-center">
                                <h4 class="chef-name text-white mb-2">@item.Name</h4>
                                <p class="chef-role text-warning">@item.Position</p>
                            </div>
                        </div>
                    </div>

                }


            </div>
        </div>
    </section>

    <section class="call-to-action-section">
        <div class="container d-flex align-items-center justify-content-between">
            @foreach (var item in Model.AppointmentSections)
            {
                @if (item.IsMain)
                {
                    <div class="cta-text-content">
                        <h3 class="cta-title">@item.Catch</h3>
                        <h2 class="cta-heading">@item.Title</h2>
                        <p class="cta-subtitle">@item.Subtitle</p>
                    </div>
                }
            }
            <div class="cta-form-content d-flex align-items-center ">
                <div class="cta-form-item position-relative">
                    <img src="~/assets/imgs/booknow-icon1.png" alt="Check-In Icon" class="cta-icon">
                    <div>
                        <p class="cta-form-label">CHECK IN</p>
                    </div>
                </div>
                <div class="cta-divider"></div>
                <div class="cta-form-item position-relative">
                    <img src="~/assets/imgs/booknow-icon4.png" alt="Time Icon" class="cta-icon">
                    <div>
                        <p class="cta-form-label">TIME</p>

                    </div>
                </div>
                <div class="cta-divider"></div>
                <div class="cta-form-item position-relative">
                    <img src="~/assets/imgs/booknow-icon2.png" alt="Guests Icon" class="cta-icon">
                    <div>
                        <p class="cta-form-label">GUESTS</p>
                        <div class="dropdown">
                        </div>
                    </div>
                </div>
                <div class="cta-button-container">
                    <a href="./reservation.html" class="btn-yellow" id="bookNowBtn">BOOK NOW</a>
                </div>
            </div>
        </div>
    </section>

    @foreach (var item in Model.VideoPreviews)
    {
        @if (item.IsMain)
        {
            <section id="media" class="media-section pt-200 pb-200" style="background-image:url('../assets/imgs/@item.PreviewImage'); background-size: cover; background-position: center center; background-repeat: no-repeat;">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-12 text-center">
                            <a href="@item.YtLink" class="video-link mt-100 mb-100">
                                <img src="~/assets/imgs/play.png" alt="Play Button" class="media-play-icon">
                            </a>
                        </div>
                    </div>
                </div>
            </section>
        }
    }



    <section class="testimonials-section" style="background-image: url('./assets/imgs/test-bg.png' );  background-size: cover;">
        <div class="container text-center py-5">
            <div class="section-title">
                <h3>TESTIMONIALS</h3>
                <h2>SOME FEEDBACKS</h2>
                <div class="divider"></div>
            </div>

            <div class="testimonials-carousel">
                <div class="testimonial-card">
                    <div class="stars">
                        <span>&#9733;</span>
                        <span>&#9733;</span>
                        <span>&#9733;</span>
                        <span>&#9733;</span>
                        <span>&#9733;</span>
                    </div>
                    <p class="testimonial-text">Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.</p>
                    <h4 class="testimonial-author">JEMI D. WILLIAM</h4>
                </div>

                <div class="testimonial-card">
                    <div class="stars">
                        <span>&#9733;</span>
                        <span>&#9733;</span>
                        <span>&#9733;</span>
                        <span>&#9733;</span>
                        <span>&#9733;</span>
                    </div>
                    <p class="testimonial-text">Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.</p>
                    <h4 class="testimonial-author">JANE DOE</h4>
                </div>

                <div class="testimonial-card">
                    <div class="stars">
                        <span>&#9733;</span>
                        <span>&#9733;</span>
                        <span>&#9733;</span>
                        <span>&#9733;</span>
                        <span>&#9733;</span>
                    </div>
                    <p class="testimonial-text">Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.</p>
                    <h4 class="testimonial-author">ROSALINA WILLIAM</h4>
                </div>


            </div>


        </div>
    </section>





</main>
