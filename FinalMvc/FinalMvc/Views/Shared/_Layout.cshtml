<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/pikaday/1.8.2/css/pikaday.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pikaday/1.8.2/pikaday.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" />
    @if (ViewContext.RouteData.Values["Controller"].ToString() == "MenuPage")
    {
        <link rel="stylesheet" href="~/assets/css/menu.css">



    }
   
     @if (ViewContext.RouteData.Values["Controller"].ToString() == "Home" ) {
    <link rel="stylesheet" href="~/assets/css/style.css">
     }
  
    <link rel="stylesheet" href="~/assets/css/contact.css">
     @if (ViewContext.RouteData.Values["Controller"].ToString() == "Blog") {
    <link rel="stylesheet" href="~/assets/css/blog.css">  
     }
    @if (ViewContext.RouteData.Values["Controller"].ToString() == "TestimonialPage")
    {
        <link rel="stylesheet" href="~/assets/css/blog.css">
    }
      @if (ViewContext.RouteData.Values["Controller"].ToString() == "Account") {
     <link rel="stylesheet" href="~/assets/css/account.css">
        <link rel="stylesheet" href="~/assets/css/style.css">
        <link rel="stylesheet" href="~/assets/css/about.css">


      }
       @if (ViewContext.RouteData.Values["Controller"].ToString() == "About") {
    <link rel="stylesheet" href="~/assets/css/about.css">
       }
        @if (ViewContext.RouteData.Values["Controller"].ToString() == "Reservation") {
    <link rel="stylesheet" href="~/assets/css/reservation.css"> 
        }

</head>

<body>

    @await Component.InvokeAsync("Header")


@RenderBody()
    @RenderSection("Scripts", required: false)
    @RenderSection("Styles", required: false)



@await Component.InvokeAsync("Footer")

    <script src="~/assets/js/about.js"></script>
    <script src="~/assets/js/menu.js"></script>
    <script src="~/assets/js/account.js"></script>
    <script src="~/assets/js/reservation.js"></script>
    <script src="~/assets/js/blog.js"></script>
    <script src="~/assets/js/contact.js"></script>
    <script src="~/assets/js/script.js"></script>








    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.3/dist/jquery.validate.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
    }

<script src="https://kit.fontawesome.com/0094c222b8.js" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
</body>
</html>
