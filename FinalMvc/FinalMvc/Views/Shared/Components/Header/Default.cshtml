@model Dictionary<string,string>


<header>
    <nav class="navbar navbar-light" style="background-color: transparent;">
        <div id="header-sticky" class="container">
            <div class="col-xl-2 col-lg-2">
                <a class="navbar-brand header-logo" asp-controller="Home" asp-action="Index">
                    <img src="~/assets/imgs/logo.png" width="30" height="30" alt="">
                </a>
            </div>
            <div class="navigator">
                <ul class="navbar-nav d-flex flex-row ">
                    <li class="nav-item px-3"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item px-3"><a class="nav-link" asp-controller="About" asp-action="Index">About Us</a></li>
                    <li class="nav-item px-3"><a class="nav-link" href="./menu.html">Menu</a></li>
                    <li class="nav-item px-3"><a class="nav-link" asp-controller="Blog" asp-action="Index">Blog</a></li>  
                    <li class="nav-item px-3"><a class="nav-link" asp-controller="Testimonial" asp-action="Index">Testimonials</a></li>

                    <li class="nav-item px-3"><a class="nav-link" href="./contact.html">Contact</a></li>
                    <li class="nav-item px-3 dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button">
                            Account
                        </a>
                        <ul class="dropdown-menu">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <form asp-controller="Account" asp-action="Logout" method="post" >
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">@User.Identity.Name</a></li>

                                <li><hr class="dropdown-divider"></li>

                                    <button type="submit" class="dropdown-item">
                                        <a>Logout</a>
                                    </button>
                                </form>




                            }
                            else
                            {
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Login">Login</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Register">Register</a></li>
                            }

                          
                        </ul>
                    </li>
                     @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("SuperAdmin")))
            {
                        <li class="nav-item px-3 button-nav">
                            <a class="btn book-seat rounded-pill px-4 py-2" asp-controller="Admin" asp-action="Dashboard">Go to Admin</a>
                        </li>
            }
            else
            {
                        <li class="nav-item px-3 button-nav">
                            <a class="btn book-seat rounded-pill px-4 py-2" href="./reservation.html">BOOK SEAT</a>
                        </li>
            }
                </ul>
            </div>
        </div>
        <div class="menu-toggle d-lg-none" id="menuToggle">
            <span class="menu-icon" id="menuIcon">&#9776;</span>
        </div>
        <div class="side-menu" id="sideMenu">
            <div class="menu-toggle d-lg-none" id="menuToggle">
                <span class="close-icon" id="closeIcon">&times;</span>
            </div>
            <ul class="side-menu-list">
                <li><a href="#">Home</a></li>
                <li><a href="./about.html">About Us</a></li>
                <li><a href="#">Menu</a></li>
                <li><a href="#">Blog</a></li>
                <li><a href="#">Contact</a></li>
                <li class="dropdown">
                    <a href="#" id="accountToggle" class="dropdown-toggle">
                        <span>Account</span>
                    </a>
                    <ul class="dropdown-list d-none" id="accountDropdown">
                        <li><a href="#">Login</a></li>
                        <li><a href="#">Register</a></li>
                    </ul>
                </li>
                <button class="button-78" role="button">BOOK SEAT</button>
            </ul>
        </div>
        <div class="overlay" id="overlay"></div>
    </nav>
</header>