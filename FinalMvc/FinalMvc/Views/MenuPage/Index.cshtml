@model MenuPageVM

<section class="headerbottomabout-section" style="background-image: url('../assets/imgs/test-bg.png');">
    <div class="container text-center">
        <div class="headerbottomabout-content">
            <h1 class="headerbottomabout-title">MENU</h1>
            <nav class="breadcrumb">
                <a href="index.html">Home</a>
                <span>></span>
                <a href="#" class="active">Menu</a>
            </nav>
        </div>
    </div>
</section>

<style>
    .menu-item {
        border-radius: 15px;
        overflow: hidden;
        background: white;
        transition: all 0.3s ease-in-out;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    }

        .menu-item:hover {
            transform: translateY(-5px);
            box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.2);
        }

        .menu-item img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .menu-item h5 {
            font-size: 1.5rem;
            font-weight: bold;
        }

        .menu-item p {
            font-size: 1rem;
            color: #555;
        }

        .menu-item .price {
            font-size: 1.2rem;
            font-weight: bold;
        }

    .pagination a {
        cursor: pointer;
    }
</style>

<div class="container my-5">

    <div class="row mb-4 justify-content-center">
        <div class="col-md-3">
            <select id="categoryFilter" class="form-select">
                <option value="">All Categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Name" selected="@(Model.SelectedCategory == category.Name ? "selected" : null)">
                        @category.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <select id="priceFilter" class="form-select">
                <option value="">Sort by Price</option>
                <option value="low">Low to High</option>
                <option value="high">High to Low</option>
            </select>
        </div>

        <div class="col-md-3">
            <input type="search" id="searchBox" class="form-control" placeholder="Search by name...">
        </div>
    </div>

    <div class="row g-4" id="menuItems">
        @foreach (var food in Model.Foods)
        {
            <div class="col-md-4 menu-item text-center p-3" data-price="@food.Price" data-category="@food.FoodCategory.Name">
                <img src="/assets/imgs/@food.Image" alt="@food.Name" class="rounded-top">
                <div class="p-3">
                    <h5 class="text-dark">@food.Name</h5>
                    <p class="text-muted">@food.Description</p>
                    <p class="price text-danger">
                        <strong>$@food.SellPrice</strong>
                        <span class="text-muted text-decoration-line-through">$@food.Price</span>
                    </p>
                    <a asp-controller="MenuPage" asp-action="Detail" asp-route-id="@food.Id" class="btn btn-outline-primary">View Details</a>
                </div>
            </div>
        }
    </div>

    <nav class="mt-4">
        <ul class="pagination justify-content-center" id="pagination">
        </ul>
    </nav>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    const itemsPerPage = 6;
    let currentPage = 1;
    let originalItems = $('.menu-item').clone();

    function paginate(items) {
        const totalItems = items.length;
        const totalPages = Math.ceil(totalItems / itemsPerPage);
        $('#pagination').empty();

        if (totalPages > 1) {
            for (let i = 1; i <= totalPages; i++) {
                $('#pagination').append(`<li class="page-item ${(i === currentPage ? 'active' : '')}">
                            <a class="page-link" href="#" data-page="${i}">${i}</a>
                        </li>`);
            }
        }

        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        items.hide().slice(start, end).show();
    }

    function filterItems() {
        const category = $('#categoryFilter').val().toLowerCase();
        const priceOrder = $('#priceFilter').val();
        const searchText = $('#searchBox').val().toLowerCase();

        $('#menuItems').empty().append(originalItems.clone());
        let filteredItems = $('.menu-item');

        if (category) {
            filteredItems = filteredItems.filter(function () {
                return $(this).data('category').toLowerCase() === category;
            });
        }

        if (searchText) {
            filteredItems = filteredItems.filter(function () {
                return $(this).find('h5').text().toLowerCase().includes(searchText);
            });
        }

        let sortedItems = filteredItems.toArray().sort((a, b) => {
            const priceA = parseFloat($(a).data('price'));
            const priceB = parseFloat($(b).data('price'));
            return priceOrder === 'low' ? priceA - priceB : priceB - priceA;
        });

        $('#menuItems').empty().append(sortedItems);
        paginate($(sortedItems));
    }

    $(document).on('change keyup', '#categoryFilter, #priceFilter, #searchBox', function () {
        currentPage = 1;
        filterItems();
    });

    $(document).on('click', '#pagination a', function (e) {
        e.preventDefault();
        currentPage = parseInt($(this).data('page'));
        filterItems();
    });

    $(document).ready(function () {
        originalItems = $('.menu-item').clone();
        filterItems();
    });
</script>
