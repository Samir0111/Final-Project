@model string

<div class="container mt-5 d-flex justify-content-center align-items-center" style="min-height: 100vh; padding-top: 80px;">
    <div class="card p-5 shadow-lg text-center" style="max-width: 400px; width: 100%; border: none;">
        <h1 class="mb-4" style="color: #ff8500; font-weight: bold;">Verify Your Email</h1>

        <p class="mb-4" style="color: gray; font-size: 16px;">
            A verification link has been sent to <strong>@Model</strong>. Please check your inbox and follow the link to activate your account.
        </p>

        <i class="fa-solid fa-envelope mb-4" style="font-size: 3rem; color: #ff8500;"></i>

        <a asp-controller="Account" asp-action="Login" class="btn btn-warning w-100" style="background-color: #ff8500; border: none; font-weight: bold;">
            Go to Login
        </a>
    </div>
</div>
