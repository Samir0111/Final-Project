@model string


<div class="container mt-5 d-flex justify-content-center align-items-center" style="min-height: 100vh; padding-top: 80px;">
    <div class="card p-5 shadow-lg text-center" style="max-width: 400px; width: 100%; border: none;">
        <h1 class="mb-4" style="color: #28a745; font-weight: bold;">Password Successfully Changed</h1>

        <p class="mb-4" style="color: gray; font-size: 16px;">
            Your password has been successfully updated. You can now log in with your new password.
        </p>

        <i class="fa-solid fa-circle-check mb-4" style="font-size: 3rem; color: #28a745;"></i>

        <a asp-controller="Account" asp-action="Login" class="btn btn-success w-100" style="background-color: #28a745; border: none; font-weight: bold;">
            Go to Login
        </a>
    </div>
</div>

<!-- Optional CSS -->
<style>
    body {
        background-color: #121212; /* Matches your site's dark theme */
    }

    .card {
        border-radius: 10px;
    }

    .btn-success:hover {
        background-color: #218838;
    }
</style>
