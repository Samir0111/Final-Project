@model ResetPasswordVM

<div class="container mt-5 d-flex justify-content-center align-items-center" style="min-height: 100vh; padding-top: 80px;">
    <div class="card p-5 shadow-lg" style="max-width: 400px; width: 100%; border: none;">
        <h1 class="text-center mb-4" style="color: #ff8500; font-weight: bold;">Reset Your Password</h1>

        <p class="text-center mb-4" style="color: gray; font-size: 16px;">
            Enter your new password below to reset your account password.
        </p>

        <form asp-action="ResetPassword" method="post">
            <input type="hidden" asp-for="Token" />
            <div class="form-group mb-4">
                <label for="Email" class="form-label" style="color: gray; font-weight: bold;">Email Address</label>
                <input asp-for="Email" id="Email" type="email" class="form-control" style="border-color: #ff8500;" readonly />
                <span asp-validation-for="Email" class="text-danger" style="margin-top: 4px; display: block;"></span>
            </div>
            <div class="form-group mb-4">
                <label for="Password" class="form-label" style="color: gray; font-weight: bold;">New Password</label>
                <input asp-for="Password" id="Password" type="password" class="form-control" style="border-color: #ff8500;" placeholder="Enter your new password" required />
                <span asp-validation-for="Password" class="text-danger" style="margin-top: 4px; display: block;"></span>
            </div>
            <div class="d-flex justify-content-center">
                <button type="submit" class="btn btn-warning w-100" style="background-color: #ff8500; border: none; font-weight: bold;">Reset Password</button>
            </div>
        </form>
    </div>
</div>

<!-- Optional CSS -->
<style>
    body {
        background-color: #121212; /* Matches the theme of your site */
    }

    .card {
        border-radius: 10px;
    }

    .btn-warning:hover {
        background-color: #ff9900;
    }
</style>
